{
  "name": "readout-ia",
  "version": "1.0.0",
  "description": "Tailwind CSS Pipeline for Readout IA Streamlit App",
  "scripts": {
    "build:css": "tailwindcss -i ./src/styles/input.css -o ./static/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./src/styles/input.css -o ./static/tailwind.css --watch"
  },
  "devDependencies": {
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19"
  }
}
