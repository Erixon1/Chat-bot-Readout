# ==============================================================================
# READOUT IA - ARCHIVO DE CONFIGURACION DE ENTORNO (.env.example)
# ==============================================================================
# Copie este archivo como .env y complete sus credenciales reales:
# cp .env.example .env

# --- 1. Control de Modo de Ejecucion ---
# true  = Modo Simulacion / Demo (sin consumir APIs externas, persistiendo en logs locales)
# false = Modo Real (utiliza las APIs y servicios configurados abajo)
FORCE_MOCK_MODE=false

# --- 2. Proveedor de Inteligencia Artificial (OpenAI / Groq / Proveedor Compatible) ---
# Si utiliza OpenAI oficial:
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_WHISPER_MODEL=whisper-1
# OPENAI_ASSISTANT_MODEL=gpt-4o-mini

# Si utiliza Groq Cloud:
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=tu_openai_o_groq_api_key_aqui
OPENAI_CHAT_MODEL=openai/gpt-oss-120b
OPENAI_WHISPER_MODEL=whisper-large-v3
OPENAI_ASSISTANT_MODEL=openai/gpt-oss-120b

# Opcional: ID de asistente preexistente (si se deja vacio, se crea automaticamente por Scripting)
OPENAI_ASSISTANT_ID=

# --- 3. Envio de Boletas por Correo Electronico (SMTP) ---
# Para Gmail, requiere generar una "Contrasena de Aplicacion" de 16 caracteres
# (si se deja vacio, las boletas se guardan en data/email_log.jsonl)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_contrasena_de_aplicacion
SMTP_FROM=tu_correo@gmail.com

# --- 4. Registro en Hojas de Calculo (Google Sheets API) ---
# Requiere un archivo JSON de Cuenta de Servicio (Service Account) con permisos de edicion en la hoja
# (si se deja vacio, los registros se guardan en data/sheets_log.csv)
GOOGLE_SA_JSON=service_account_credentials.json
GOOGLE_SHEET_ID=tu_spreadsheet_id_o_url_completa

# --- 5. Notificaciones de WhatsApp (WhatsApp HTTP API - WAHA) ---
# Servidor local o remoto de WAHA (ejecutado via Docker)
# (si se deja vacio, los mensajes se guardan en data/whatsapp_log.jsonl)
WAHA_URL=http://localhost:3000
WAHA_SESSION=default
WAHA_API_KEY=tu_waha_api_key_opcional
